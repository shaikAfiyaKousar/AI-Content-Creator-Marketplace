PORT=5000
NODE_ENV=development

# Use your MongoDB Atlas URI for persistent data, or leave blank to use the
# local MongoDB server with an in-memory fallback for development only.
MONGODB_URI=

# Replace this value before deploying or exposing the API publicly.
JWT_SECRET=replace-this-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
